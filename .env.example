# BingoPlus Environment Configuration
# Copy this file to .env and fill in your values

# Telegram Bot
BOT_USERNAME=your_bot_username
BOT_TOKEN=your_bot_token

# Database
DB_URL=jdbc:postgresql://localhost:5432/bingo_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Super Admin Telegram ID (the Telegram user who will own the system)
SUPER_ADMIN_TELEGRAM_ID=your_telegram_id

# Mini App URL (hosted frontend URL)
BINGO_WEBAPP_URL=https://your-frontend-url.com

# Payment screenshot storage directory (optional, defaults to ./data/screenshots)
# SCREENSHOTS_DIR=./data/screenshots
