# Copy this file to deploy/.env and fill in your values (deploy/.env is git-ignored).

# --- Backend / Telegram ---
BOT_USERNAME=your_bot_username
BOT_TOKEN=your_bot_token
SUPER_ADMIN_TELEGRAM_ID=your_telegram_id

# --- Frontend URL (the public site the Telegram bot tells users to open) ---
# This is served by the separate bingo-app-front deployment.
BINGO_WEBAPP_URL=https://bingo.duckdns.org

# --- Postgres (also used by the backend against the local container) ---
POSTGRES_USER=bingo
POSTGRES_PASSWORD=change-me-strong-password

# --- Public backend domain (HTTPS via Caddy auto-TLS) ---
# This is what the frontend uses as BACKEND_ORIGIN (e.g. https://bingo-api.duckdns.org).
# Needs an A record pointing to this VM's public IP, with ports 80/443 open.
BINGO_DOMAIN=bingo-api.duckdns.org